<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ar_settings_capabilities"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchPlaneDots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/show_tracked_plane_dots"
        android:paddingVertical="8dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchInstantPlacement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enable_instant_placement"
        android:paddingVertical="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginVertical="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hardware_api_capabilities"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/capabilitiesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>